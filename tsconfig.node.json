{
  "extends": "./tsconfig.json",
  "include": ["*.config.ts", "db/seed.ts", "db/seed-sql.ts", "e2e/**/*.ts"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo/node.tsbuildinfo",
    "strict": true,
    "types": ["node"],
    "lib": ["ES2024", "DOM"],
    "target": "ES2024",
    "module": "ES2022",
    "moduleResolution": "bundler"
  }
}
